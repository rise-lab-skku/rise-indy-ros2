<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="indy">

  <xacro:arg name="arm_id" default="indy"/> <!-- Name of this indy -->
  <xacro:arg name="model" default="indy7"/> <!-- Model of the indy arm -->

  <xacro:property name="arm_id" value="$(arg arm_id)"/>
  <xacro:property name="model" value="$(arg model)"/>

  <xacro:include filename="$(find indy_moveit_config)/srdf/indy_arm.xacro"/>
  <xacro:indy_arm arm_id="${arm_id}" model="${model}"/>

</robot>